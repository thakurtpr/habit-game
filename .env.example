# Copy to .env.local for local development (never commit real values).

# Required in production: at least 32 random characters (openssl rand -base64 48).
SESSION_SECRET=

# Upstash Redis (Vercel Marketplace -> Upstash). Optional locally: without these
# the app uses an in-memory store that resets on restart.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set to false after you have signed up, so nobody else can enrol a face.
ALLOW_SIGNUP=true

# Optional overrides. By default both are derived from the request host.
# RP_ID=your-domain.com
# ORIGIN=https://your-domain.com
